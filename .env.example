NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/my_wallet

# JWT (min 32 characters each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL used in email links
FRONTEND_URL=http://localhost:5173

# Optional token TTLs (milliseconds)
# EMAIL_VERIFICATION_EXPIRES_IN_MS=86400000
# PASSWORD_RESET_EXPIRES_IN_MS=3600000

# Mail (optional in development — emails are logged to console when unset)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@mywallet.local
